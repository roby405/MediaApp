{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["apps/web/src", "packages/core/types/db.ts", "packages/core/types/filter.ts", "packages/core/types/global.ts", "packages/core/utils/shuffleList.ts", "packages/core/utils/formatSize.ts", "packages/core/utils/formatPlaybackSpeed.ts", "packages/core/utils/formatLength.ts", "packages/core/utils/formatDate.ts", "packages/core/utils/filterFiles.ts", "packages/core/utils/buildIndex.ts", "packages/core/stores/useNavStore.ts", "packages/core/stores/useFilterStore.ts", "packages/core/stores/useImportStore.ts", "packages/core/stores/useMediaStore.ts", "packages/core/stores/useScreenViewStore.ts", "packages/core/stores/useImagePlayerStore.ts", "packages/core/stores/useThemeStore.ts", "packages/core/hooks"]
}
