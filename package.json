{
  "name": "media-app-monorepo",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev:web": "pnpm --filter @media-app/web dev",
    "dev:mobile": "pnpm --filter mobile start",
    "dev:desktop": "pnpm --filter desktop tauri dev",
    
    "build:web": "pnpm --filter @media-app/web build",
    "build:mobile": "pnpm --filter mobile build",
    "build:desktop": "pnpm --filter desktop tauri build",
    
    "lint:web": "pnpm --filter @media-app/web lint",
    "lint:all": "pnpm -r run lint",
    "typecheck:all": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0"
  }
}